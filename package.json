{
  "name": "bidsphere",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "bidsphere-frontend",
    "bidsphere-backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w bidsphere-frontend\" \"npm run dev -w bidsphere-backend\"",
    "build": "npm run build -w bidsphere-frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
